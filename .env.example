NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Atlas Newsroom
DEMO_MODE=true

# Production data store (Supabase REST). Required when DEMO_MODE=false.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI writing / verification. Choose openai or ollama. Ollama can run locally with no API bill.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Scheduler endpoint authentication
CRON_SECRET=replace-with-a-long-random-secret

# Admin authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-different-long-random-secret

# JSON array of permitted/licensed feeds.
# Required keys: id, url, category, language, imageReuseAllowed, publicAttributionRequired, enabled
# Example:
# NEWS_FEEDS_JSON=[{"id":"official-feed","url":"https://example.gov/feed.xml","category":"World","language":"en","imageReuseAllowed":true,"publicAttributionRequired":false,"enabled":true}]
NEWS_FEEDS_JSON=[]
