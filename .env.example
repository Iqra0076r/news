NEXT_PUBLIC_SITE_URL=https://iqra0076r.github.io/news
NEXT_PUBLIC_SITE_NAME=BingNews
# Optional runner tuning. No paid AI API key is required.
MAX_STORIES=3
BINGNEWS_MODEL_PATH=models/newsroom.gguf
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Never put a service-role key in the website, git, or a NEXT_PUBLIC variable.
# GitHub Actions supplies its short-lived OIDC request credentials automatically.
